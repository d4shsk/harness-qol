{
  "name": "@local/harness-qol",
  "version": "1.3.0",
  "description": "Harness-QOL: modular settings toggles, multi-folder workspaces, image context menus, quoting assistant replies, side questions, and model defaults.",
  "dependencies": { "zod": "^4.1.12" },
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./workspaces": "./workspaces-entry.js",
    "./workspaces/locale/*.json": "./workspaces-locale/*.json",
    "./workspaces/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "btw.js", "model-defaults.js", "workspaces.js", "workspaces-entry.js", "workspaces-locale/*.json", "workspaces-client.js", "client.js", "images-client.js", "models-client.js", "btw-client.js", "quote-client.js", "settings-client.js", "settings-state.js", "build.mjs", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "*.test.mjs", "tests/*.test.mjs"],
  "scripts": { "build": "node build.mjs", "test": "node --test *.test.mjs tests/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-attachment", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
